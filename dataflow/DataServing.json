{
	"name": "DataServing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "LS_ADLS",
						"type": "LinkedServiceReference"
					},
					"name": "DimAirport"
				},
				{
					"linkedService": {
						"referenceName": "LS_ADLS",
						"type": "LinkedServiceReference"
					},
					"name": "DimFactbookings"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "LS_ADLS",
						"type": "LinkedServiceReference"
					},
					"name": "sinkusa"
				},
				{
					"linkedService": {
						"referenceName": "LS_ADLS",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				},
				{
					"linkedService": {
						"referenceName": "LS_ADLS",
						"type": "LinkedServiceReference"
					},
					"name": "sinkothers"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "selectcols"
				},
				{
					"name": "split"
				},
				{
					"name": "aggregateairline"
				},
				{
					"name": "sortrows"
				},
				{
					"name": "derivedColforUSA"
				},
				{
					"name": "filterondate"
				},
				{
					"name": "alterRowusa"
				},
				{
					"name": "windowTotalcost"
				},
				{
					"name": "filterRank"
				},
				{
					"name": "alterRowuk"
				},
				{
					"name": "alterRowothers"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airport_id as short,",
				"          airport_name as string,",
				"          city as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirport') ~> DimAirport",
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as integer,",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'Dimbookings') ~> DimFactbookings",
				"DimFactbookings, DimAirport join(destination_airport_id == airport_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          booking_id,",
				"          passenger_id,",
				"          flight_id,",
				"          airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          airport_name,",
				"          city,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectcols",
				"selectcols split(country == 'USA',",
				"     country == 'USA',",
				"     disjoint: false) ~> split@(USA, UK, Others)",
				"split@Others aggregate(groupBy(airline_id),",
				"     Totalsum = sum(ticket_cost)) ~> aggregateairline",
				"aggregateairline sort(asc(airline_id, true)) ~> sortrows",
				"split@USA derive(USA = country == 'USA') ~> derivedColforUSA",
				"derivedColforUSA filter(booking_date >= toDate('2025-05-01')) ~> filterondate",
				"filterRank alterRow(insertIf(1==1)) ~> alterRowusa",
				"filterondate window(over(USA),",
				"     desc(ticket_cost, true),",
				"     TicketRank = denseRank()) ~> windowTotalcost",
				"windowTotalcost filter(TicketRank <= 10) ~> filterRank",
				"split@UK alterRow(insertIf(1==1)) ~> alterRowuk",
				"sortrows alterRow(insertIf(1==1)) ~> alterRowothers",
				"alterRowusa sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'gold',",
				"     folderPath: 'bussinesUSA',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkusa",
				"alterRowuk sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'gold',",
				"     folderPath: 'bussinesUSA',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"alterRowothers sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'gold',",
				"     folderPath: 'bussinesOthers',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkothers"
			]
		}
	}
}