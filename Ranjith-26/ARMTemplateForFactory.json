						"castcost sort(asc(checkin_status, true)) ~> sortcheckinstatus",
						"sortcheckinstatus filter(ticket_cost < 1000 && ticket_cost > 700) ~> filterticketcost",
						"filterticketcost alterRow(upsertIf(1==1)) ~> alterBooking",
						"alterAirpot sink(allowSchemaDrift: true,",
