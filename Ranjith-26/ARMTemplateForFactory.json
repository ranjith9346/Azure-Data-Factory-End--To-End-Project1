						"     format: 'parquet') ~> FactBookings",
						"DimAirport derive(country = upper(country)) ~> derivedCountry",
						"derivedCountry select(mapColumn(",
						"          airport_id,",
						"          airport_name,",
						"          city,",
						"          country",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcols",
						"selectcols sort(asc(airport_name, true)) ~> sortcountry",
						"sortcountry alterRow(upsertIf(1==1)) ~> alterAirpot",
						"FactBookings cast(output(",
